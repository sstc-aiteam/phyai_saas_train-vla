# Copy to .env.local (not committed) and fill in real values.
VITE_API_BASE_URL=http://localhost:8000
# The reCAPTCHA v3 *site* key (public, safe in frontend JS) -- paired with
# the secret key already set server-side via Secret Manager. Get it from
# the same reCAPTCHA admin console page where the secret key was created.
VITE_RECAPTCHA_SITE_KEY=
