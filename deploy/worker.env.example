# Copy to /etc/lerobot-worker/worker.env (referenced by lerobot-worker.service)
# and fill in real values. Keep this file out of version control once filled in.

# GCP service account key JSON (spec section 2: worker auths to
# Firestore/GCS via a service account key file, not ADC/workload identity).
GOOGLE_APPLICATION_CREDENTIALS=/etc/lerobot-worker/gcp-service-account.json

# See src/worker/config.py:WorkerSettings for the full list and defaults.
LEROBOT_WORKER_GCS_BUCKET=lerobot-training-service-prod
LEROBOT_WORKER_LOCK_FILE_PATH=/run/lerobot-worker/lerobot-worker.lock
LEROBOT_WORKER_HF_CACHE_DIR=/var/lib/lerobot-worker/hf-cache
LEROBOT_WORKER_HF_CACHE_MAX_BYTES=21474836480
LEROBOT_WORKER_WORKDIR=/var/lib/lerobot-worker/jobs
LEROBOT_WORKER_TMP_STALE_AFTER_SECONDS=3600
LEROBOT_WORKER_POLL_INTERVAL_SECONDS=5
LEROBOT_WORKER_ACT_IMAGE=lerobot-train-act:latest
LEROBOT_WORKER_SMOLVLA_IMAGE=lerobot-train-smolvla:latest
